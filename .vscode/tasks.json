{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "dev server",
            "command": "trunk",
            "args": ["serve"],
            "isBackground": true,
            "presentation": {
                "revealProblems": "onProblem"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^([^:]+):(\\d+).*ERROR.*",
                    "file": 1,
                    "line": 2
                },
                "background": {
                    "activeOnStart": false,
                    "beginsPattern": ".*Rebuilding.*",
                    "endsPattern": ".*server listening at:.*"
                }
            }
        }
    ]
}

