{
  "productName": "TwiliRecipes",
  "identifier": "net.curiana.recipes",
  "version": "0.2.8",
  "build": {
    "beforeBuildCommand": "trunk build",
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "cli": {
      "args": [
        {
          "short": "c",
          "name": "config",
          "description": "Config file name",
          "takesValue": true
        },
        {
          "short": "r",
          "name": "recipes",
          "description": "Recipes file name",
          "takesValue": true
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MDRENDIyMEYwNDlEMUEKUldRYW5RUVBJdFFFbGFSaE53SXU4eUZ2bHROM0pCejFzTlZtZFZ0a29sb3JvMFFtbGVFbFZyVlEK",
      "endpoints": [
        "https://github.com/kandrelczyk/twili-recipes/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "android": {
      "versionCode": 10
    },
    "createUpdaterArtifacts": true,
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "visible": false,
        "title": "TwiliRecipes",
        "width": 600
      }
    ]
  }
}
